{
  "name": "solidity-language-server-monorepo",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "homepage": "https://hardhat.org/hardhat-vscode/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NomicFoundation/hardhat-vscode"
  },
  "bugs": {
    "url": "https://github.com/NomicFoundation/hardhat-vscode/issues"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc -b ./client/tsconfig.json && tsc -b ./server/tsconfig.build.json && tsc -b ./coc/tsconfig.json",
    "watch": "concurrently -n client,server \"tsc -b -w ./client/tsconfig.json\" \"tsc -b -w ./server/tsconfig.build.json\"",
    "test:unit": "pnpm --filter ./server run test",
    "test:protocol": "pnpm --filter ./test/protocol run test",
    "test:e2e": "pnpm --filter ./test/e2e run test",
    "test:scripts": "node --test \"scripts/release/**/*.test.ts\"",
    "test": "pnpm run test:unit && pnpm run test:protocol && pnpm run test:e2e && pnpm run test:scripts",
    "test:coverage": "pnpm --filter ./server run test:coverage",
    "test:codecov": "pnpm --filter ./server run test:codecov",
    "lint": "pnpm run prettier --check && pnpm run eslint && pnpm --filter ./client run lint && pnpm --filter ./server run lint && pnpm --filter ./coc run lint && pnpm --filter ./test/protocol run lint && pnpm run lint:scripts",
    "lint:fix": "pnpm run prettier --write && pnpm run eslint --fix && pnpm --filter ./client run lint:fix && pnpm --filter ./server run lint:fix && pnpm --filter ./coc run lint:fix && pnpm --filter ./test/protocol run lint:fix && pnpm run lint:scripts:fix",
    "prettier": "prettier *.md *.json \"{docs,syntaxes,.github,.vscode}/**/*.{md,yml,json}\"",
    "eslint": "eslint ./test/**/*.ts",
    "clean": "rimraf ./dist ./out && pnpm --filter ./client run clean && pnpm --filter ./server run clean",
    "generate-readmes": "ts-node scripts/interpolateReadmes.ts",
    "prepackage": "pnpm run generate-readmes",
    "package": "pnpm --filter ./client run package",
    "release:version": "node scripts/release/main.ts prepare-release-pr:update-versions-for-release",
    "release": "node scripts/release/main.ts",
    "prettier:scripts": "prettier \"scripts/release/**/*.{ts,json}\"",
    "tsc:scripts": "tsc --noEmit -p scripts/release/tsconfig.json",
    "lint:scripts": "pnpm run prettier:scripts --check && pnpm run tsc:scripts",
    "lint:scripts:fix": "pnpm run prettier:scripts --write && pnpm run tsc:scripts",
    "prefullcheck": "pnpm run clean",
    "fullcheck": "pnpm run lint && pnpm run build && pnpm run test && pnpm run package"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^10.0.10",
    "@types/module-alias": "2.0.4",
    "@types/node": "^22.13.10",
    "@types/vscode": "~1.101.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "concurrently": "7.1.0",
    "dotenv": "16.0.3",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "glob": "^7.1.7",
    "mocha": "^11.8.0",
    "prettier": "3.9.6",
    "rimraf": "3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "5.8.2"
  }
}
